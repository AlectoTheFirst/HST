{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "hst values",
  "description": "additionalProperties is false throughout on purpose: a mistyped key is otherwise accepted in silence and the install differs from what the values file says.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "global": { "type": ["object", "null"] },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "buildRevision": { "type": "string" }
      }
    },

    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },

    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsUser", "runAsGroup"],
      "properties": {
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 }
      }
    },

    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "profiles"],
      "properties": {
        "profile": { "enum": ["standard", "enterprise"] },
        "profiles": {
          "type": "object", "additionalProperties": false,
          "required": ["standard", "enterprise"],
          "properties": {
            "standard": { "$ref": "#/definitions/analysisProfile" },
            "enterprise": { "$ref": "#/definitions/analysisProfile" }
          }
        }
      }
    },

    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "securityContext": { "type": "object" },
        "podAnnotations": { "type": ["object", "null"] },
        "forwardedAllowIps": {
          "type": "string",
          "description": "HST_FORWARDED_ALLOW_IPS with ingress.enabled: comma-separated addresses and networks, or *; empty trusts no proxy; a value requires networkPolicy.ingressFrom"
        },
        "publicUrl": {
          "type": "string",
          "pattern": "^(|https?://[^/?#@]+/?)$",
          "description": "The origin that users reach (HST_PUBLIC_URL), with no path"
        },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "envFrom": { "type": "array", "items": { "type": "object" } },
        "nodeSelector": { "type": ["object", "null"] },
        "tolerations": { "type": "array" },
        "affinity": { "type": ["object", "null"] },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessMode": {
              "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]
            }
          }
        }
      }
    },

    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "podAnnotations": { "type": ["object", "null"] },
        "extraEnv": { "type": "array", "items": { "type": "object" } },
        "envFrom": { "type": "array", "items": { "type": "object" } },
        "nodeSelector": { "type": ["object", "null"] },
        "tolerations": { "type": "array" },
        "affinity": { "type": ["object", "null"] }
      }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },

    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string", "minLength": 1 },
        "extraHosts": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": ["object", "null"] },
        "acceptInsecureHttp": { "type": "boolean" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },

    "demo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixtures": {
          "type": "string",
          "description": "The demo estate folder in the image; empty offers no demo load"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cookieSecure": { "type": "boolean" },
        "sessionTtlHours": { "type": "integer", "minimum": 1 },
        "loginRateLimit": { "type": "integer", "minimum": 1 },
        "loginRateWindowSeconds": { "type": "integer", "minimum": 1 }
      }
    },

    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "Secret with the keys secret-key, neo4j-password and postgres-password, plus postgres-dsn with postgres.enabled=false"
        },
        "rotationStamp": { "type": ["string", "integer"] },
        "secretKey": { "type": "string" },
        "neo4jPassword": { "type": "string" },
        "postgresPassword": { "type": "string" }
      }
    },

    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "waitAttempts": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },

    "initDb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "waitAttempts": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    },

    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "externalDsn": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "caSecret": { "type": "string" },
            "serverSecret": {
              "type": "string",
              "description": "kubernetes.io/tls Secret that turns on the TLS listener of the bundled Postgres; empty leaves it off"
            }
          }
        },
        "acceptInsecure": {
          "type": "boolean",
          "description": "true renders the bundled Postgres without tls.serverSecret and a non-loopback externalDsn without tls.enabled"
        },
        "resources": { "type": "object" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        }
      }
    },

    "neo4j": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string", "minLength": 1 },
        "externalUri": { "type": "string" },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "caSecret": { "type": "string" },
            "serverSecret": {
              "type": "string",
              "description": "kubernetes.io/tls Secret that turns on the bolt TLS listener of the bundled Neo4j; empty leaves it off"
            }
          }
        },
        "acceptInsecure": {
          "type": "boolean",
          "description": "true renders the bundled Neo4j without tls.serverSecret and a non-loopback externalUri without tls.enabled"
        },
        "heap": { "type": "string" },
        "pagecache": { "type": "string" },
        "transactionMemory": { "type": "string" },
        "resources": { "type": "object" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": { "type": "string" },
            "storageClass": { "type": "string" }
          }
        }
      }
    },

    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": {
          "type": "array",
          "items": { "type": "object" },
          "description": "NetworkPolicy peers that reach port 8787 of the app pod; app.forwardedAllowIps requires 1 or more"
        },
        "dnsTo": { "type": "array", "items": { "type": "object" } }
      }
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": ["object", "null"] }
      }
    },

    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },

    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "recoverySecretName": { "type": "string" },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string", "pattern": "^(|https://.+)$" },
            "bucket": { "type": "string" },
            "prefix": { "type": "string" },
            "secretName": { "type": "string" }
          }
        },
        "s3ClientImage": { "type": "string", "minLength": 1 },
        "resources": { "type": "object" },
        "recoveryResources": { "type": "object" }
      }
    }
  },
  "definitions": {
    "analysisProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["engine", "workers", "memoryMb", "timeoutSeconds", "cacheMb", "resultMb"],
      "properties": {
        "engine": { "enum": ["legacy-v1", "symbolic-v2"] },
        "workers": { "type": "integer", "minimum": 1, "maximum": 1 },
        "memoryMb": { "type": "integer", "minimum": 256, "maximum": 16384 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "cacheMb": { "type": "integer", "minimum": 64, "maximum": 1048576 },
        "resultMb": { "type": "integer", "minimum": 64, "maximum": 1048576 },
        "resources": { "type": "object" },
        "clockQuality": { "enum": ["unknown", "trusted"] },
        "clockAssumption": { "type": "string" },
        "evidenceMaxAgeSeconds": { "type": "integer", "minimum": 0 },
        "evidenceMaxSkewSeconds": { "type": "integer", "minimum": 0 },
        "evidenceConsistency": { "enum": ["bounded-window", "stable-window-assumption"] },
        "evidenceStableWindowAssumption": { "type": "string" }
      }
    }
  }
}
