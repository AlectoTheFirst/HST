# Copy to .env and fill in. Two consumers read this file:
#   - host-side tools (the `hst` CLI, `hst serve` and `hst worker` run on
#     the host, the MCP server) read it from the current working directory
#   - compose reads it automatically from the repo root for `${...}`
#     substitution. No service loads it with `env_file:`, so a container
#     receives a setting only where compose.yaml or compose.worker.yaml names it.
#
# Set HST_SECRET_KEY, HST_PG_PASSWORD and NEO4J_PASSWORD before the first
# `up`; compose refuses to start while any of them is empty.
#
# Passwords: letters, digits and `-_.` are safe. Compose substitution eats `$`,
# and `@` or `%` split the Postgres DSN.

# The twin database. Inside the compose stack the app talks to bolt://neo4j:7687
# by service name and ignores this; host-side tools use it directly.
NEO4J_URI=bolt://localhost:7687
# The Neo4j URI of the `app` and `init` containers of the compose stack. Set it
# for a Neo4j outside the stack.
#NEO4J_URI_CONTAINER=bolt://neo4j:7687
NEO4J_USER=neo4j
# Seeds the compose Neo4j, but ONLY on a first start against an empty volume: it
# is baked into the database and changing it later needs a reset. On a volume
# reused from an earlier Neo4j this must match the password that database was
# created with, or every query fails to authenticate.
# `openssl rand -hex 24` generates a value.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# PEM CA bundle for verified bolt TLS to a networked Neo4j. Empty leaves the URI
# scheme in charge (plaintext for bolt://, which is fine on loopback only).
#NEO4J_TLS_CA_FILE=
# Cycle history retention: prune deletes graph data of runs beyond the newest
# N. The current run always stays. This is the default
# only: Settings -> Lifecycle stores a value that overrides it, and the hourly
# maintenance sweep, `hst prune` and `hst sidestore prune` use whichever is
# in force; `--keep N` replaces the cycle count for one run.
#CYCLE_KEEP_RUNS=30
# Device and refresh runs kept beside the cycles: the newest N that are newer than
# the oldest kept cycle. Each is a full copy of the graph; 48 is eight hours at the
# default device run interval. Settings -> Lifecycle overrides it the same way.
#CYCLE_KEEP_DEVICE_RUNS=48
# The maintenance sweep makes one device run from the per-device payloads at this
# interval, in seconds.
#DEVICE_RUN_INTERVAL_S=600

# The name of the estate. Each published snapshot manifest holds it.
#ESTATE_NAME=default

# The L2 fabrics of the estate as a JSON object. A key is a fabric name, and its
# value is the list of the source names in the fabric. A source that no fabric
# lists is in the default fabric.
#L2_FABRICS={"dmz": ["vyos-dmz", "unifi-dmz"]}

# The role tokens of the hostnames as a JSON object. A key is a token, and its
# value is the design tier. The value replaces the default map of
# src/hst/core/device_roles.py as a whole.
#HOSTNAME_TIER_TOKENS={"cr": "core", "as": "access"}

# Raw snapshots, side-store parquet, snapshot manifests, and the wrapped data key
HST_DATA_DIR=./data

# `hst serve` on the host connects with this DSN. The compose stack builds its
# DSN from HST_PG_PASSWORD.
POSTGRES_DSN=postgresql+asyncpg://hst:change-me@localhost:5433/hst
# The password of the compose Postgres, applied on a first start against an
# empty volume. `openssl rand -hex 24` generates a value.
HST_PG_PASSWORD=
SESSION_TTL_HOURS=168
# The absolute TTL above is a ceiling, not the only bound: a session unused for
# this long stops authenticating even with hours left on it. The cookie is a
# bearer credential for an account that can trigger collection against production
# management planes, so a week of it on an unattended browser is the exposure.
SESSION_IDLE_TIMEOUT_HOURS=8
# PEM CA bundle for verified Postgres TLS (hostname-checked). asyncpg without it
# is opportunistic and unverified; any networked Postgres should set this.
#POSTGRES_CA_FILE=

# The session cookie's Secure flag follows the request scheme: behind a TLS
# terminator, set HST_FORWARDED_ALLOW_IPS below and X-Forwarded-Proto does the
# rest. Set true only for a terminator that sends no forwarded headers.
COOKIE_SECURE=false

# The analysis engine. legacy-v1 is the interval engine; symbolic-v2 uses the
# native backend the image carries (policy_evaluate explain_rule needs it). The
# worker runs in the app container beside collection, so give that container more
# memory with it: the Helm enterprise profile uses these values.
#ANALYSIS_ENGINE=symbolic-v2
#ANALYSIS_MEMORY_MB=2048
#ANALYSIS_TIMEOUT_S=300
#ANALYSIS_CACHE_MB=20480
#ANALYSIS_RESULT_MB=20480
#HST_APP_MEM_LIMIT=6g
# With false, the app starts no analysis worker and refuses an analysis.
#ANALYSIS_ENABLED=true

# Failed logins per window, per IP and per username, before further attempts are
# refused. Both buckets are checked before either is consulted, so a wrong password
# for a real account costs the same as one for an account that does not exist.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_S=60

# Retention for the two audit tables the app writes on its own: one row per
# authentication decision (login_events) and one per Cypher call, HTTP or agent
# (cypher_events). Both are written on paths the caller drives, so keeping them
# forever is storage someone else sizes; the scheduled maintenance jobs delete
# rows older than these. 0 keeps everything, for a deployment shipping them
# elsewhere or holding a longer obligation. Defaults only: Settings -> Lifecycle
# stores values that override both.
LOGIN_EVENT_RETENTION_DAYS=90
CYPHER_EVENT_RETENTION_DAYS=180

# Retention for the AI tables. A conversation is deleted with its messages once
# its last message is older than AI_CONVERSATION_RETENTION_DAYS. A tool step
# result (ai_steps) older than AI_STEP_RESULT_DAYS is compacted to its digest
# and summary. An ai_events row is deleted once it is older than
# AI_EVENT_RETENTION_DAYS. 0 keeps everything. Defaults only: Settings ->
# Lifecycle stores values that override them.
AI_CONVERSATION_RETENTION_DAYS=90
AI_STEP_RESULT_DAYS=14
AI_EVENT_RETENTION_DAYS=180

# A finished job is kept for this number of days. 0 keeps each job. The
# Lifecycle settings override the value.
JOB_HISTORY_RETENTION_DAYS=30

# A raw file, a side-store file or a manifest is kept for at least this number
# of days. An unset value turns the period off.
#EVIDENCE_RETENTION_DAYS=

# The key that signs the snapshot manifests, of at least 32 bytes. With no key
# the manifests are unsigned. The file wins when both are set.
#EVIDENCE_SIGNING_KEY=
#EVIDENCE_SIGNING_KEY_FILE=

# The app loads this GeoNames postal code file into the place table.
#GEO_PLACES_FILE=

# The folder of the synthetic demo estate. With a value, an admin can load the
# estate on the Runs page. The image holds the folder at
# /usr/share/hst/demo-enterprise, and the repository at fixtures/demo-enterprise.
# A demo instance runs ANALYSIS_ENGINE=symbolic-v2.
#HST_DEMO_FIXTURES=

# With true, `hst serve` runs the scheduler and the job executor. `hst worker`
# ignores this setting.
#SCHEDULER_ENABLED=true

# With true, `hst serve` and `hst worker` apply the Alembic migrations at start-up.
#HST_RUN_MIGRATIONS=true

# Where a run triggered from the UI or POST /api/runs executes. `inline` (the
# default) starts it in the process that answered. `queue` enqueues a
# `collect.run` job, which the process running an executor claims and executes:
# `hst worker` when the API sets SCHEDULER_ENABLED=false. compose.yaml passes
# no env_file to `app`, so this line applies to a host-run `hst serve`;
# compose.worker.yaml sets it for `app`.
#RUN_EXECUTION=inline

# The memory limit of the `worker` container in compose.worker.yaml. The `app`
# container's limit is 4g in compose.yaml. A load holds about 1.1 GB for an
# IOS-XE full-table device and about 3.6 GB for an NX-OS one.
#HST_WORKER_MEM_LIMIT=4g

# The scheduler starts a full cycle at this interval, in seconds. 0 turns
# periodic collection off.
#COLLECT_INTERVAL_S=0

# Concurrent asyncssh fetches of a cycle or a source refresh: asyncio tasks
# under a semaphore of this size. Fetches are network-bound, so this bounds
# concurrent SSH sessions, not CPU. It bounds memory too: with spilling on,
# at most this many plus one of those fetches hold a full payload at once,
# each until the payload is hashed and sealed. Per-device jobs are not
# counted here.
#COLLECT_MAX_CONCURRENCY=8

# The paramiko devices and the HTTP collectors fetch in a thread pool of this
# size.
#COLLECT_THREAD_WORKERS=8

# Change detection. A device whose raw payload matches the one on record
# skips normalize and load. A payload that is normalized and whose graph
# batch digests as the one on record skips its Neo4j write, and its side
# tables are written. Either way the device's graph objects are carried
# forward, for at most this long: the batch is written again this often,
# which bounds how old a carried object gets.
#COLLECT_FULL_INTERVAL_S=900

# The scheduler stops fanning out per-device jobs while the queue holds this
# many pending jobs; devices stay due and overload degrades to "polled less
# often", never to a backlog.
#COLLECT_QUEUE_HIGH_WATER=1000

# A device that keeps failing doubles its own polling interval per
# consecutive failure, up to this cap. The other devices of its group keep
# their cadence.
#COLLECT_BACKOFF_CAP_S=900

# Concurrent job bodies in one executor, the one `hst serve` embeds or the
# one `hst worker` runs (per-device fetches, queued runs and re-parses, plus
# the handful of maintenance jobs). Each per-device fetch holds its device's
# payload while it runs, beside any run in the same process.
#COLLECT_WORKER_CONCURRENCY=16

# The collector host's clock declaration, stamped into every device entry of a
# published manifest. "trusted" says the host clock is synchronized to the
# analysis clock and requires the assumption text that states the basis for
# that trust. Both stay unset for a host whose clock is not vouched for.
#COLLECTOR_CLOCK_QUALITY=unknown
#COLLECTOR_CLOCK_ASSUMPTION=

# How many fetch results a cycle or a source refresh holds between the
# concurrent fetch phase and the serial load. The fetch phase fetches in
# windows of this size and drops each result as the loader takes it. A result
# whose payload is at or above COLLECT_SPILL_MB is held as a sealed file under
# <data>/raw/.spill rather than in memory. A window narrower than
# COLLECT_MAX_CONCURRENCY leaves fetch slots idle.
#COLLECT_FETCH_BUFFER=64

# In the fetch phase of a cycle or a source refresh, a payload whose size in
# memory is at or above this many MiB is sealed to a spill file under
# <data>/raw/.spill once it is hashed, and its load reads it back from there.
# The size compared is the payload's in memory, not its file size. 0 holds
# every payload in memory until its load.
#COLLECT_SPILL_MB=8

# The largest answer, in MiB, one SSH command may give, on asyncssh and
# paramiko, exec channel and shell. The read stops at the first piece past it
# and closes the channel; the command fails with a detail that states the
# limit and the size read, and nothing of its answer is kept. An optional
# command is then a failed section and a required one fails the device. On a
# shell session the next command runs on a new shell of the same connection.
# 0 reads every answer whole. One HTTP response body has the same limit.
#COLLECT_MAX_ANSWER_MB=1024

# Rows per parquet row group in the side store. The writer emits one row group
# at a time, so a device with a full internet table costs this many rows of
# buffers rather than all of them.
#SIDESTORE_ROW_GROUP_ROWS=65536

# gzip level, 1 to 9, of new raw payload files. Level 6 seals a full-table
# payload in a fifth to a half of the CPU time of level 9 for a file about 3 to
# 15 percent larger. Any level reads back to the same content.
#RAW_COMPRESS_LEVEL=6

# The sources whose HTTP requests and responses a fetch records, as source names
# separated by commas. `*` records every source. An empty value records none.
#HST_HTTP_TRACE=

# The log level and the log format. `json` writes one object per line.
#HST_LOG_LEVEL=INFO
#HST_LOG_FORMAT=text

# The app trusts the X-Forwarded-* headers of these reverse proxies. The value
# holds IPs or CIDRs, separated by commas.
HST_FORWARDED_ALLOW_IPS=

# The origin that users reach, for example https://hst.example.net, with no
# path. SAML and OIDC sign-in need it.
HST_PUBLIC_URL=

# The largest request body, in MiB, that the app reads. A larger request gets
# 413.
#HST_MAX_REQUEST_BODY_MB=16

# The built SPA. Served by `hst serve` when index.html is present there, otherwise
# the API runs headless. Relative paths resolve against the working directory.
WEB_DIST=web/dist

# The operator key. It wraps a data key (generated on first use, stored at
# HST_DATA_DIR/dek.wrapped) that seals source credentials, AI provider keys and
# the raw device snapshots. Any value of at least 32 bytes; `hst secret-key`
# generates one. Rotation is `hst rotate-secret-key` and never rewrites data.
#
# KEEP A COPY IN YOUR SECRET STORE. Losing it makes every stored credential and
# every raw snapshot unreadable; it is not recoverable from any database.
HST_SECRET_KEY=

# Alternative to the above: a path to a file holding the key (container secrets,
# Kubernetes Secret volumes). The file wins when both are set.
#HST_SECRET_KEY_FILE=

# `hst serve` terminates TLS with these PEM files. `hst serve` needs
# TLS_CERT_FILE and TLS_KEY_FILE together. TLS_KEY_PASSWORD_FILE is the path of
# the passphrase file.
#TLS_CERT_FILE=
#TLS_KEY_FILE=
#TLS_KEY_PASSWORD_FILE=

# Trust for the app's own outbound HTTPS: AI providers (Anthropic, Bedrock and
# its STS call, OpenRouter), OIDC discovery and token exchange, SAML metadata.
# A TLS-intercepting proxy's CA goes in TLS_CA_BUNDLE (a PEM file path; it
# replaces the system store). TLS_VERIFY=false skips verification for every
# such connection. Each AI provider, OIDC provider and SAML provider can
# override both from its settings form. Collectors keep their per-source TLS.
#TLS_VERIFY=true
#TLS_CA_BUNDLE=

# Model-authored Cypher (query_cypher in the agent and over MCP) must reference
# $snap, or it reads every retained run. `refuse` rejects such a query with the
# guard guidance. `warn` runs it, logs a warning and returns the guidance with
# the rows. POST /api/cypher and the query catalog do not apply the rule.
#HST_AI_CYPHER_PINNING=refuse

# The check of agent tool arguments against each tool's input model. `enforce`
# returns the mismatch to the model as the call's error and does not run the
# call. `warn` logs one hst.ai warning that names the tool and the failing
# field paths, and runs the call.
#HST_AI_TOOL_VALIDATION=enforce
